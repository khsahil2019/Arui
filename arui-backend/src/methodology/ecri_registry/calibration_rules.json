[
  {
    "id": "CAL-01",
    "name": "Metric Normalization",
    "formula": "M_norm = (M / 5) * 100; I_norm = (I / 5) * 100"
  },
  {
    "id": "CAL-02",
    "name": "Performance Composition",
    "formula": "P = wM * M_norm + wI * I_norm + wO * O"
  },
  {
    "id": "CAL-03",
    "name": "Dimension Score",
    "formula": "DimensionScore = WeightedMean(Applicable Metric Performances)"
  },
  {
    "id": "CAL-04",
    "name": "Overall ECRI Score",
    "formula": "OverallECRI = Sum(DimensionScore_d * Weight_d) across D01-D11"
  }
]